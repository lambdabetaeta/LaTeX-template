\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{maths}[2026/11/11 General mathematical notation]

\RequirePackage{mathtools}
\RequirePackage{stmaryrd}
\RequirePackage{jmsdelim}

%% Defining equality and equivalence
\NewDocumentCommand{\defeq}{}{\stackrel{\mathclap{\mbox{\tiny def}}}{=}}
\NewDocumentCommand{\defequiv}{}{\stackrel{\mathclap{\mbox{\tiny def}}}{\equiv}}

%% Some bracket shorthands
\NewDocumentCommand{\prn}{m}{\DelimPrn{#1}}
\NewDocumentCommand{\brc}{m}{\DelimBrc{#1}}
\NewDocumentCommand{\brk}{m}{\DelimBrk{#1}}
\NewDocumentCommand{\gls}{m}{\DelimGl{#1}}
\NewDocumentCommand{\abs}{m}{\DelimSurround{\lvert}{\rvert}{#1}}

%% \sem{M}      produces [[M]]
%% \sem{M}[\rho] produces [[M]]_rho
\NewDocumentCommand{\sem}{mo}{\DelimBbrk{#1}\IfValueT{#2}{_{#2}}}

%% \OptPrn{<star>}{x} parenthesises x exactly when <star> is \BooleanTrue,
%% i.e. when passed the #1 of a command whose signature starts with s.
\NewDocumentCommand{\OptPrn}{mm}{\IfBooleanTF{#1}{\DelimPrn{#2}}{#2}}

%% Sets
\NewDocumentCommand{\FinSub}{}{\subseteq_\text{fin}}
\NewDocumentCommand{\SetComp}{mm}{\DelimBetweenSurround{\lbrace}{\vert}{\rbrace}{#1}{#2}}
\NewDocumentCommand{\Powerset}{so}{\mathcal{P}\IfValueT{#2}{\OptPrn{#1}{#2}}}

%% Functions
\NewDocumentCommand{\FunctionSet}{smm}{\OptPrn{#1}{#2 \to #3}}
\NewDocumentCommand{\Surj}{}{\twoheadrightarrow}
\NewDocumentCommand{\Image}{sm}{\mathop{\text{im}}\OptPrn{#1}{#2}}
\NewDocumentCommand{\DepFun}{mmm}{\DelimPrn{#1 : #2} \to #3}

%% Lists
\NewDocumentCommand{\List}{sm}{\OptPrn{#1}{#2}^{\ast}}
\NewDocumentCommand{\FinInfList}{sm}{\OptPrn{#1}{#2}^{\infty}}
\NewDocumentCommand{\ListBrk}{m}{\DelimBrk{#1}}
\NewDocumentCommand{\ListComp}{mm}{\DelimBetweenSurround{[}{\vert}{]}{#1}{#2}}
\NewDocumentCommand{\EmptyList}{}{[\,]}
\NewDocumentCommand{\ConsList}{mm}{#1{:}#2}
\NewDocumentCommand{\ConcatOp}{}{\mathbin{{+}\mspace{-8mu}{+}}}

%% Booleans
\NewDocumentCommand{\Booleans}{}{\mathbb{B}}
\NewDocumentCommand{\TrueBool}{}{\textbf{tt}}
\NewDocumentCommand{\FalseBool}{}{\textbf{ff}}

%% Accents

%% A harpoon counterpart of \overrightarrow.
\makeatletter
\def\rightharpoonupfill@{\arrowfill@\relbar\relbar\rightharpoonup}
\NewDocumentCommand{\overrightharpoonup}{}{\mathpalette{\overarrow@\rightharpoonupfill@}}
\makeatother

%% A bar wider than \bar but narrower than \overline. From
%% https://tex.stackexchange.com/questions/16337/can-i-get-a-widebar-without-using-the-mathabx-package/60253#60253
\makeatletter
\newcommand*\rel@kern[1]{\kern#1\dimexpr\macc@kerna}
\newcommand*\widebar[1]{%
  \begingroup
  \def\mathaccent##1##2{%
    \rel@kern{0.8}%
    \overline{\rel@kern{-0.8}\macc@nucleus\rel@kern{0.2}}%
    \rel@kern{-0.2}%
  }%
  \macc@depth\@ne
  \let\math@bgroup\@empty \let\math@egroup\macc@set@skewchar
  \mathsurround\z@ \frozen@everymath{\mathgroup\macc@group\relax}%
  \macc@set@skewchar\relax
  \let\mathaccentV\macc@nested@a
  \macc@nested@a\relax111{#1}%
  \endgroup
}
\makeatother
