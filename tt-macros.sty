\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tt-macros}[2026/11/11 Dependent and modal type theory]

\RequirePackage{maths}
\RequirePackage{categories}
\RequirePackage{wasysym}

\NewDocumentCommand{\Sum}{m}{\textstyle \DelimMin{2}\sum_{\DelimProtect{#1}}}
